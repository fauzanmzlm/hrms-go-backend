# HTTP server
APP_PORT=8080
LOG_LEVEL=info
# Maximum time allowed for in-flight requests to finish on shutdown
SHUTDOWN_TIMEOUT=15s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s

# MySQL (go-sql-driver DSN). parseTime=true and loc=UTC are forced by the app.
DB_DSN=hrms:hrms@tcp(127.0.0.1:3306)/hrms
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
# Apply embedded migrations on startup
AUTO_MIGRATE=true

# Auth (JWT_SECRET must be at least 32 bytes)
JWT_SECRET=change-me-to-a-long-random-string-of-32+-bytes
JWT_ISSUER=hrms-go-backend
JWT_TTL=8h
BCRYPT_COST=12

# An approved disciplinary penalty blocks promotion for this many months (0 disables)
PROMOTION_DISCIPLINARY_BLOCK_MONTHS=12

# Creates this ADMIN account on startup if it does not exist yet
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe-2026
